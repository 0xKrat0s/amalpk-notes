---
/**
 * Analytics body block: the SPA pageview bridge.
 *
 * `astro:page-load` fires on the initial load and after every ClientRouter
 * navigation, so pushing one `page_view` event there gives tags in the GTM
 * container exactly one event per navigation (configure the Analytics tag
 * in the container to trigger on the custom event `page_view`).
 */
---

<script is:inline>
  (function () {
    if (window.__pageviewBound) return;
    window.__pageviewBound = true;
    document.addEventListener("astro:page-load", function () {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: "page_view",
        page_location: window.location.href,
        page_path: window.location.pathname + window.location.search,
        page_title: document.title,
      });
    });
  })();
</script>
