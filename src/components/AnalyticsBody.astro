---
/**
 * Analytics body block: the GA4 SPA pageview listener.
 *
 * `astro:page-load` fires on the initial load and after every ClientRouter
 * navigation, so sending one `page_view` there gives exactly one event per
 * navigation for GA4 (loaded directly via gtag.js — see AnalyticsHead).
 */
import config from "@/config";

const { analytics } = config;
const measurementId = analytics.measurementId ?? "";
---

<script is:inline define:vars={{ measurementId }}>
  (function () {
    if (window.__pageviewBound) return;
    window.__pageviewBound = true;
    document.addEventListener("astro:page-load", function () {
      window.gtag("event", "page_view", {
        page_location: window.location.href,
        page_path: window.location.pathname + window.location.search,
        page_title: document.title,
        send_to: measurementId,
      });
    });
  })();
</script>
