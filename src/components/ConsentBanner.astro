---
/**
 * Minimal cookie-consent banner.
 *
 * Rendered only when `analytics.consentBanner` is enabled. Accept/decline calls
 * `gtag("consent", "update", …)` — hiding the banner alone leaves Consent Mode
 * at "denied" and GA4 would only send cookieless pings.
 */
---

<div
  id="consent-banner"
  hidden
  role="region"
  aria-label="Cookie consent"
  class="border-border bg-background/95 fixed inset-x-0 bottom-0 z-50 border-t backdrop-blur-sm"
>
  <div
    class="app-layout flex flex-col gap-3 py-4 text-sm sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="text-muted-foreground max-w-prose">
      This site uses analytics cookies to understand which posts are useful. No
      ads, and no data is sold. You can decline and still read everything.
    </p>
    <div class="flex flex-none items-center gap-2">
      <button
        type="button"
        data-consent="denied"
        class="border-border hover:bg-muted rounded border px-3 py-1.5 font-medium transition-colors"
      >
        Decline
      </button>
      <button
        type="button"
        data-consent="granted"
        class="bg-accent text-[#16181d] hover:bg-accent/90 rounded px-3 py-1.5 font-medium transition-colors"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = "consent-mode";

    function stored() {
      try {
        return localStorage.getItem(KEY);
      } catch (e) {
        return null;
      }
    }

    function sync() {
      var banner = document.getElementById("consent-banner");
      if (!banner) return;
      if (stored()) {
        banner.setAttribute("hidden", "");
      } else {
        banner.removeAttribute("hidden");
      }
    }

    function apply(state) {
      if (typeof window.gtag === "function") {
        window.gtag("consent", "update", {
          ad_storage: state,
          ad_user_data: state,
          ad_personalization: state,
          analytics_storage: state,
        });
      }
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "consent_update", consent_state: state });
    }

    if (!window.__consentBound) {
      window.__consentBound = true;

      // Delegated so it keeps working after ClientRouter swaps the body.
      document.addEventListener("click", function (event) {
        var button =
          event.target.closest && event.target.closest("[data-consent]");
        if (!button) return;

        var state = button.getAttribute("data-consent");
        try {
          localStorage.setItem(KEY, state);
        } catch (e) {}

        var banner = document.getElementById("consent-banner");
        if (banner) banner.setAttribute("hidden", "");
        apply(state);
      });

      document.addEventListener("astro:page-load", sync);
    }

    sync();
  })();
</script>
