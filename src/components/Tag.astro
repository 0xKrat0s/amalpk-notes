---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  variant?: "default" | "chip";
};

const { tag, tagName, size = "lg", variant = "default" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `directory/tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "flex items-center gap-0.5",
      variant === "chip"
        ? "bg-muted/40 hover:text-accent rounded-full px-3 py-1"
        : "hover:text-accent",
      "focus-visible:text-accent",
      { "text-sm": size === "sm" },
      { "text-base": size === "lg" && variant === "chip" },
      { "text-lg": size === "lg" && variant === "default" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" && variant === "default" },
        { "size-4": size === "lg" && variant === "chip" },
        { "size-4": size === "sm" },
      ]}
    />
    {tagName}
  </a>
</li>
