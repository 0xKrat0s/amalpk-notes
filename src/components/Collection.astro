---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import config from "@/config";

type Props = {
  path: string;
  name: string;
  depth: number;
  postCount: number;
  isFirst: boolean;
};

const { path, name, depth, postCount, isFirst } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<li
  class:list={[
    "group",
    depth === 0 ? ["pt-5", !isFirst && "mt-3"] : "ms-4 ps-4 sm:ms-6",
  ]}
>
  <a
    href={getRelativeLocaleUrl(locale, `directory/collections/${path}/`)}
    class:list={[
      "hover:text-accent focus-visible:text-accent inline-flex w-fit items-center gap-1",
      depth === 0 ? "text-lg font-semibold sm:text-xl" : "text-base",
    ]}
  >
    <IconArrowRight
      class:list={["opacity-80", depth === 0 ? "size-5" : "size-4"]}
    />
    {name}
    <span
      class:list={[
        "text-muted-foreground",
        depth === 0 ? "text-sm" : "bg-muted rounded-full px-1.5 py-0.5 text-xs",
      ]}
    >
      ({postCount})
    </span>
  </a>
</li>
